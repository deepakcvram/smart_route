# SafeRoute AI — Environment Configuration Example
# Copy this file to .env and configure your personal API keys.
# Do NOT commit your actual .env file with secrets to GitHub.

# OpenWeatherMap API Key (for live weather observation at route midpoint)
# Obtain from: https://openweathermap.org/api
OPENWEATHER_KEY=your_openweather_api_key_here

# NewsAPI Key (for daily automated accident news ingestion and model retraining)
# Obtain from: https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here

# Google Gemini API Key (optional — for AI-generated driver alert descriptions)
# Obtain from: https://aistudio.google.com/
# If left blank, the application automatically uses intelligent rule-based safety briefs.
GEMINI_KEY=your_gemini_api_key_here
